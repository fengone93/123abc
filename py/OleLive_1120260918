import base64
import hashlib
import json
import time
import urllib.parse
from datetime import datetime

import requests
from base.spider import Spider

try:
    from Crypto.Cipher import AES
except ImportError:
    AES = None


class Spider(Spider):
    def __init__(self):
        self.name = "欧乐原版修正0918"
        self.host = "https://olelive.com"
        self.api = "https://api.olelive.com"
        self.image_base = "https://static.olelive.com"
        self.header = {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) "
                "Chrome/136.0.0.0 Safari/537.36 Edg/136.0.0.0"
            ),
            "Referer": "https://olelive.com/",
            "Origin": "https://olelive.com",
        }
        self.timeout = 20
        self._types = []

    def getName(self):
        return self.name

    def init(self, extend=""):
        pass

    def isVideoFormat(self, url):
        pass

    def manualVideoCheck(self):
        pass

    def destroy(self):
        pass

    def _sign(self):
        ts = str(int(time.time()))
        parts = [[], [], [], []]
        for char in ts:
            bits = bin(ord(char))[2:]
            parts[0].append(bits[2:3])
            parts[1].append(bits[3:4])
            parts[2].append(bits[4:5])
            parts[3].append(bits[5:])
        encoded = []
        for part in parts:
            value = hex(int("".join(part) or "0", 2))[2:]
            if len(value) == 2:
                value = "0" + value
            elif len(value) == 1:
                value = "00" + value
            elif len(value) == 0:
                value = "000"
            encoded.append(value)
        digest = hashlib.md5(ts.encode()).hexdigest()
        return (
            digest[:3] + encoded[0] + digest[6:11] + encoded[1]
            + digest[14:19] + encoded[2] + digest[22:27]
            + encoded[3] + digest[30:]
        )

    def _decrypt(self, data):
        if AES is None:
            return data
        date_text = datetime.now().strftime("%Y-%m-%d")
        key = hashlib.md5(date_text.encode()).hexdigest()[8:24]
        cipher = AES.new(key.encode(), AES.MODE_CBC, iv=key.encode())
        plain = cipher.decrypt(base64.b64decode(data))
        return plain.rstrip(b"\x00").decode("utf-8", "ignore")

    def _api_get(self, path, params=None):
        query = dict(params or {})
        query["_vv"] = self._sign()
        try:
            response = requests.get(
                self.api + path,
                headers=self.header,
                params=query,
                timeout=self.timeout,
            )
            if response.status_code == 200:
                payload = response.json()
                if payload.get("code") == 0:
                    data = payload.get("data")
                    if isinstance(data, str):
                        try:
                            return json.loads(data)
                        except Exception:
                            try:
                                return json.loads(self._decrypt(data))
                            except Exception:
                                return data
                    return data
        except Exception:
            pass
        return None

    def _load_types(self):
        if self._types:
            return
        data = self._api_get("/v1/pub/vod/list/type")
        if not data:
            return
        for item in data:
            if item.get("typeEn") == "chengren":
                continue
            if "直播" in item.get("typeName", "") or "live" in (item.get("typeEn") or "").lower():
                continue
            children = []
            for child in item.get("children") or []:
                if "直播" in child.get("typeName", "") or "live" in (child.get("typeEn") or "").lower():
                    continue
                children.append({
                    "type_name": child.get("typeName", ""),
                    "type_id": str(child.get("typeId")),
                })
            self._types.append({
                "type_name": item.get("typeName", ""),
                "type_id": str(item.get("typeId")),
                "children": children,
                "area": item.get("area") or [],
                "year": item.get("year") or [],
            })

    def _get_filters(self):
        filters = {}
        for item in self._types:
            groups = []

            values = [{"n": "全部", "v": ""}]
            for child in item.get("children") or []:
                values.append({"n": child["type_name"], "v": child["type_id"]})
            if len(values) > 1:
                groups.append({"key": "class", "name": "类型", "value": values})

            values = [{"n": "全部", "v": ""}]
            for area in item.get("area") or []:
                values.append({"n": area, "v": area})
            if len(values) > 1:
                groups.append({"key": "area", "name": "地区", "value": values})

            values = [{"n": "全部", "v": ""}]
            for year in item.get("year") or []:
                values.append({"n": year, "v": year})
            if len(values) > 1:
                groups.append({"key": "year", "name": "年代", "value": values})

            if groups:
                filters[item["type_id"]] = groups
        return filters

    def _pic(self, item):
        value = item.get("picThumb") or item.get("pic") or ""
        if not value:
            return ""
        if value.startswith("http"):
            return value
        if value.startswith("/"):
            return self.image_base + value
        return self.image_base + "/" + value

    def _make_vod(self, item):
        return {
            "vod_id": str(item.get("id", "")),
            "vod_name": item.get("name", ""),
            "vod_pic": self._pic(item),
            "vod_remarks": item.get("remarks", ""),
        }

    def homeContent(self, filter):
        result = {"class": [], "list": []}
        self._load_types()
        for item in self._types:
            result["class"].append({
                "type_name": item["type_name"],
                "type_id": item["type_id"],
            })
        if filter:
            result["filters"] = self._get_filters()
        data = self._api_get("/v1/pub/index/vod/data/2")
        if data:
            result["list"] = [self._make_vod(item) for item in data.get("list", [])]
        return result

    def homeVideoContent(self):
        return {}

    def categoryContent(self, tid, pg, filter, extend):
        page = int(pg)
        result = {
            "list": [],
            "page": page,
            "pagecount": 999,
            "limit": 24,
            "total": 0,
        }
        extend = extend or {}
        child_type = extend.get("class") or "0"
        area = extend.get("area") or "0"
        year = extend.get("year") or "0"
        data = self._api_get(
            "/v1/pub/vod/list/1/3/0/{}/{}/{}/{}/update/{}/24".format(
                area, tid, child_type, year, page
            )
        )
        if data:
            result["list"] = [self._make_vod(item) for item in data.get("list", [])]
            result["total"] = data.get("total", 0)
            result["pagecount"] = (result["total"] + 23) // 24
        return result

    def detailContent(self, ids):
        if not ids or not ids[0]:
            return {"list": []}
        vod_id = ids[0]
        data = self._api_get("/v1/pub/vod/detail/{}/1".format(vod_id))
        if not data:
            return {"list": []}

        normal = []
        for item in data.get("urls") or []:
            title = item.get("title", "") or "第{}集".format(item.get("index", ""))
            url = item.get("url", "")
            if url:
                normal.append("{}${}".format(title, url))

        if not normal:
            return {"list": []}
        return {"list": [{
            "vod_id": vod_id,
            "vod_name": data.get("name", ""),
            "vod_pic": self._pic(data),
            "vod_remarks": data.get("remarks", ""),
            "vod_year": str(data.get("year", "")),
            "vod_area": data.get("area", ""),
            "type_name": data.get("typeId1Name", ""),
            "vod_actor": data.get("actor", ""),
            "vod_director": data.get("director", ""),
            "vod_content": data.get("content", "") or data.get("blurb", ""),
            "vod_play_from": "欧乐高清",
            "vod_play_url": "#".join(normal),
        }]}

    def searchContent(self, key, quick):
        return self._search(key, "1")

    def searchContentPage(self, key, quick, pg):
        return self._search(key, pg)

    def _search(self, key, pg):
        page = str(pg or "1")
        result = {"list": [], "page": page}
        keyword = urllib.parse.quote(str(key))
        data = self._api_get(
            "/v1/pub/index/search/{}/vod/0/{}/24".format(keyword, page)
        )
        if data:
            for group in data.get("data") or []:
                if group.get("type") == "vod":
                    result["list"].extend(
                        self._make_vod(item) for item in group.get("list") or []
                    )
        return result

    def playerContent(self, flag, id, vipFlags):
        headers = {
            "User-Agent": self.header["User-Agent"],
            "Referer": self.host + "/",
        }
        return {"parse": 0, "url": id, "header": headers, "playUrl": ""}

    def fetch(self, url):
        try:
            response = requests.get(url, headers=self.header, timeout=self.timeout)
            response.encoding = "utf-8"
            if response.status_code == 200:
                return response.text
            return None
        except Exception:
            return None

    def localProxy(self, param):
        return None
